# =====================================================================
# SunRise Solar Internship — .gitignore
#
# .gitignore affects only files Git is not already tracking.
# Already committed files remain tracked and in history until deliberately
# removed. These rules do not perform a history or tracked-file cleanup.
# =====================================================================

# --- Credentials and secrets -----------------------------------------
.env
.env.*
*.key
*.pem
*.p12
*.jks
credentials.json
sfdx-auth-url.txt
*auth-url*
.sfdx/
.sf/
.sfdxauth
**/*authFile*.json
**/*sfdxAuthUrl*

# --- Salesforce CLI / tooling noise ----------------------------------
.localdevserver/
deploy-options.json
*.log
*.bak
node_modules/
coverage/
.nyc_output/
test-result*.json
junit-custom*.xml

# --- OS and editor ---------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*.swp
*~
~$*
.vscode/
.idea/
*.iml

# --- Working files that should not be published ----------------------
scratch/
tmp/
_to_delete/
*.tmp
*.partial

# --- Data that has NOT been reviewed for PII --------------------------
# Reviewed exports live under evidence/ and are committed on purpose.
# Drop new data in unreviewed/ first; move it out after review.
# Raw/unredacted filename patterns also apply inside evidence/.
unreviewed/
**/raw-export*.csv
**/*-unredacted.*
**/*-RAW.*

# --- Review artifacts produced by sanitise-check.sh -------------------
# These are build products, not evidence; do not publish them.
# Run ./sanitise-check.sh to generate a fresh private review directory.
.sanitise-review/
